# Copy this to .env and fill values before running
FLASK_ENV=development
SECRET_KEY=replace_with_a_random_secret
JWT_SECRET_KEY=replace_with_a_jwt_secret

# Database Configuration - Choose ONE option below:

# OPTION 1: PostgreSQL (RECOMMENDED for production)
# Get DATABASE_URL from your PostgreSQL provider (Render, Supabase, Railway, Heroku, etc.)
DATABASE_URL=postgresql://username:password@host:port/database_name

# OPTION 2: MySQL (Alternative)
# USE_MYSQL=true
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=example_password
# DB_NAME=disaster_db

# OPTION 3: SQLite (Default for development - no configuration needed)
# If DATABASE_URL and USE_MYSQL are not set, SQLite will be used automatically
